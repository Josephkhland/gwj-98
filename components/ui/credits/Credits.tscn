text = "Pause scroll"
focus_mode = 0

[node name="Back" type="Button" parent="UI"]
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = 30.0
offset_top = -113.0
offset_right = 250.0
offset_bottom = -65.0
text = "Back to menu"
focus_mode = 0

[node name="Controls" type="RichTextLabel" parent="UI"]
anchor_left = 0.5
