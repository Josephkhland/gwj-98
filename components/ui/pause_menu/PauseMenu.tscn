[gd_scene format=3]

[ext_resource type="Script" path="res://components/ui/pause_menu/pause_menu.gd" id="1"]

[ext_resource type="PackedScene" path="res://components/ui/options/OptionsMenu.tscn" id="options"]
[ext_resource type="Script" path="res://components/ui/input_icons/input_hint_label.gd" id="hints"]

[sub_resource type="Theme" id="MenuTheme"]
default_font_size = 24

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 50
script = ExtResource("1")

[node name="Dim" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.6)

[node name="Center" type="CenterContainer" parent="."]
theme = SubResource("MenuTheme")
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="Column" type="VBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Center/Panel/Margin/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Paused"
horizontal_alignment = 1

[node name="OptionsButton" type="Button" parent="Center/Panel/Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 48)
layout_mode = 2
text = "Options"

[node name="QuitButton" type="Button" parent="Center/Panel/Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "Quit to menu"
custom_minimum_size = Vector2(0, 48)

[node name="ResumeHint" type="RichTextLabel" parent="Center/Panel/Margin/Column"]
layout_mode = 2
text = "[action:ui_cancel] Resume"
script = ExtResource("hints")
theme_override_font_sizes/normal_font_size = 18

[node name="OptionsMenu" parent="." instance=ExtResource("options")]
