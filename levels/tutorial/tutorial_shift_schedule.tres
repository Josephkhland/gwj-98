[sub_resource type="Resource" id="Message1"]
script = ExtResource("message")
message_id = &"tutorial_practice_1"
title = "Talk to Mr. Pipsqueak"
from_house = &"tutorial_a"
to_house = &"tutorial_b"
text = "If you encounter someone during your shift, like me, you may talk to them using your interact control."
sender = ExtResource("squirrel")
recipient = ExtResource("deer")
warning_minutes = 54.0
expire_minutes = 180.0
unlock_character = ExtResource("squirrel")
unlock_chain = ExtResource("chat")
time_basis = 1
real_seconds = 3.0

[sub_resource type="Resource" id="Message2"]
script = ExtResource("message")
message_id = &"tutorial_practice_2"
title = "Practice delivery 2"
from_house = &"tutorial_a"
to_house = &"tutorial_b"
text = "Check the minimap: keep a route between our house portraits before this message expires."
sender = ExtResource("squirrel")
recipient = ExtResource("deer")
warning_minutes = 54.0
expire_minutes = 180.0
time_basis = 1
real_seconds = 11.0

[sub_resource type="Resource" id="Message3"]
