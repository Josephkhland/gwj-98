minute = 15

[resource]
script = ExtResource("2_sched")
notifications = Array[ExtResource("1_note")]([SubResource("Message_morning"), SubResource("Message_newt"), SubResource("Break_deck"), SubResource("Message_owl"), SubResource("Break_random"), SubResource("Sunset"), SubResource("Message_late")])
