[ext_resource type="Script" uid="uid://31g58cjce0dt" path="res://components/modules/messaging/message_notification.gd" id="3_msg"]

[sub_resource type="Resource" id="Message_morning"]
script = ExtResource("3_msg")
message_id = &"morning_hello"
from_house = &"frog_house"
to_house = &"croc_house"
text = "Good morning, neighbour!"
warning_minutes = 20.0
expire_minutes = 60.0
keyword = &"message"
hour = 8

[sub_resource type="Resource" id="Message_newt"]
script = ExtResource("3_msg")
message_id = &"newt_invite"
from_house = &"croc_house"
to_house = &"newt_house"
text = "Swamp party at noon?"
points = 150
expire_minutes = 90.0
keyword = &"message"
hour = 9
minute = 0

[sub_resource type="Resource" id="Break_deck"]
