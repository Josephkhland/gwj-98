[gd_resource type="Resource" script_class="MessageNotification" format=3]

[ext_resource type="Script" path="res://components/modules/messaging/message_notification.gd" id="message"]
[ext_resource type="Resource" path="res://resources/character_profiles/deer_character_profile.tres" id="deer"]
[ext_resource type="Resource" path="res://resources/character_profiles/internet_character_profile.tres" id="remote"]

[resource]
resource_name = "Deer 07"
script = ExtResource("message")
hour = 12
minute = 12
message_id = &"deer_07"
from_house = &"deer_house"
route = 1
text = "Maaambo Jambo..."
sender = ExtResource("deer")
recipient = ExtResource("remote")
